# Render supplies PORT. Local default is 8080.
PORT=8080
NODE_ENV=development
# Set securely in Render's Environment panel; never put this in the frontend.
# Without this key, claims use sentence segmentation and factual/cross-modal
# analysis reports insufficient evidence. No hardcoded truth verdicts.
GEMINI_API_KEY=
# Must support generateContent, Google Search grounding, and image inputs.
GEMINI_MODEL=gemini-2.5-flash
# English OCR downloads/caches Tesseract language data on first use.
OCR_ENABLED=true
